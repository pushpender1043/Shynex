# ----------------------------------------------------------------------
# 1. DEPENDENCIES & LOGS (Common for all sub-folders)
# ----------------------------------------------------------------------
# Node modules for the root, frontend, and backend
/node_modules
/backend/node_modules
/frontend/node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------------------------------------
# 2. BUILD OUTPUTS (What the deployment platform will create)
# ----------------------------------------------------------------------
# Common build folder names
/build
/coverage
/dist

# Frontend Build Output (Vite/React ka build folder)
/frontend/dist
/frontend/dist-ssr

# Backend Build (Agar backend mein koi build step hai)
/backend/build 

# ----------------------------------------------------------------------
# 3. ENVIRONMENT & SECRETS (CRITICAL SECURITY)
# ----------------------------------------------------------------------
# Environment Variables (Root, Frontend, Backend sabse rokta hai)
**/.env
**/.env.local
**/.env.*.local
**/*.local
**/.secrets

# Firebase Admin Key (Agar server par use hua hai)
/backend/*.json